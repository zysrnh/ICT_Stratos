    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 120,
      "left": -140,
      "attrs": { "min": "0", "max": "4095", "value": "1200" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": -80,
      "left": 180,
      "attrs": { "color": "green", "label": "NORMAL" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": 10,
      "left": 180,
      "attrs": { "color": "red", "label": "ALERT" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -45,
      "left": 230,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 45,
      "left": 230,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "dht1:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "dht1:VCC", "red", [ "v0" ] ],
    [ "esp:15", "dht1:SDA", "blue", [ "v0" ] ],
    [ "esp:GND.2", "pot1:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot1:VCC", "red", [ "v0" ] ],
    [ "esp:34", "pot1:SIG", "green", [ "v0" ] ],
    [ "esp:2", "led_green:A", "green", [ "v0" ] ],
    [ "led_green:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:19", "led_red:A", "red", [ "v0" ] ],
    [ "led_red:C", "r2:1", "black", [ "v0" ] ],
    [ "r2:2", "esp:GND.2", "black", [ "v0" ] ]
