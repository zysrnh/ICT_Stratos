{
  "version": 1,
  "author": "Huawei ICT Innovation Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": 100,
      "left": 200,
      "attrs": { "i2cAddress": "0x3c" }
    },

    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -30,
      "left": -165,
      "attrs": { "temperature": "36.6", "humidity": "60" }
    },

    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 160,
      "left": -165,
      "attrs": { "min": "0", "max": "4095", "value": "1500" }
    },

    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": -30,
      "left": 200,
      "attrs": { "color": "red", "label": "SOS" }
    },

    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 280,
      "left": 200,
      "attrs": { "volume": "0.1" }
    },

    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": 310,
      "left": -165,
      "attrs": { "color": "green", "label": "SYNC" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 360,
      "left": -165,
      "attrs": { "value": "220" },
      "rotate": 90
    }
  ],
  "connections": [
    [ "dht1:VCC", "esp:3V3",   "red",   [ "h20" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "h20" ] ],
    [ "dht1:SDA", "esp:32",    "blue",  [ "h20" ] ],

    [ "pot1:VCC", "esp:3V3",   "red",   [ "h20" ] ],
    [ "pot1:GND", "esp:GND.1", "black", [ "h20" ] ],
    [ "pot1:SIG", "esp:34",    "green", [ "h20" ] ],

    [ "oled1:VCC", "esp:3V3",   "red",    [ "h-20" ] ],
    [ "oled1:GND", "esp:GND.2", "black",  [ "h-20" ] ],
    [ "oled1:SCL", "esp:22",    "yellow", [ "h-20" ] ],
    [ "oled1:SDA", "esp:21",    "cyan",   [ "h-20" ] ],

    [ "btn1:1.l",  "esp:19",    "orange", [ "h-20" ] ],
    [ "btn1:2.l",  "esp:GND.2", "black",  [ "h-20" ] ],

    [ "bz1:1",     "esp:18",    "purple", [ "h-20" ] ],
    [ "bz1:2",     "esp:GND.2", "black",  [ "h-20" ] ],

    [ "esp:2",      "led_green:A", "green", [ "h-20" ] ],
    [ "led_green:C","r1:1",        "black", [ "v10"  ] ],
    [ "r1:2",       "esp:GND.1",   "black", [ "v10"  ] ]
  ],
  "dependencies": {}
}
