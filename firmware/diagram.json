{
  "version": 1,
  "author": "Huawei ICT Innovation Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -150,
      "left": 160,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -120,
      "left": -150,
      "attrs": { "temperature": "36.6", "humidity": "60" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 120,
      "left": -150,
      "attrs": { "min": "0", "max": "4095", "value": "1500" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 100,
      "left": 190,
      "attrs": { "color": "red", "label": "SOS" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 200,
      "left": 180,
      "attrs": { "volume": "0.1" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": -130,
      "left": 310,
      "attrs": { "color": "green", "label": "SYNC" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -90,
      "left": 310,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:GND.1", "oled1:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled1:VCC", "red", [ "v0" ] ],
    [ "esp:22", "oled1:SCL", "yellow", [ "v0" ] ],
    [ "esp:21", "oled1:SDA", "cyan", [ "v0" ] ],

    [ "esp:GND.1", "dht1:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "dht1:VCC", "red", [ "v0" ] ],
    [ "esp:15", "dht1:SDA", "blue", [ "v0" ] ],

    [ "esp:GND.2", "pot1:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot1:VCC", "red", [ "v0" ] ],
    [ "esp:34", "pot1:SIG", "green", [ "v0" ] ],

    [ "esp:19", "btn1:1.l", "orange", [ "v0" ] ],
    [ "esp:GND.2", "btn1:2.l", "black", [ "v0" ] ],

    [ "esp:18", "bz1:1", "purple", [ "v0" ] ],
    [ "esp:GND.2", "bz1:2", "black", [ "v0" ] ],

    [ "esp:2", "led_green:A", "green", [ "v0" ] ],
    [ "led_green:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
