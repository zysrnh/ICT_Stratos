{
  "version": 1,
  "author": "Huawei ICT Innovation Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -140,
      "left": 0,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": 20,
      "left": -150,
      "attrs": { "temperature": "36.6", "humidity": "60" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 160,
      "left": -150,
      "attrs": { "min": "0", "max": "4095", "value": "1500" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 50,
      "left": 160,
      "attrs": { "color": "red", "label": "SOS" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 160,
      "left": 160,
      "attrs": { "volume": "0.1" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": -120,
      "left": 160,
      "attrs": { "color": "green", "label": "SYNC" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -80,
      "left": 160,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:SDA", "esp:32", "blue", [ "v0" ] ],

    [ "pot1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot1:SIG", "esp:34", "green", [ "v0" ] ],

    [ "oled1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "oled1:VCC", "esp:3V3", "red", [ "v-20", "h-70" ] ],
    [ "oled1:SCL", "esp:22", "yellow", [ "v0" ] ],
    [ "oled1:SDA", "esp:21", "cyan", [ "v0" ] ],

    [ "btn1:1.l", "esp:19", "orange", [ "v0" ] ],
    [ "btn1:2.l", "esp:GND.2", "black", [ "v0" ] ],

    [ "bz1:1", "esp:18", "purple", [ "v0" ] ],
    [ "bz1:2", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:2", "led_green:A", "green", [ "v0" ] ],
    [ "led_green:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
